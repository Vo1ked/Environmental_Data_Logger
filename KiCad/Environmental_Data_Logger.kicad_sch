	(text "CE = VOUT: reverse-current blocking. USB D+/D-/SBU unused.\nNormal operation requires +5V_SYS >= 4.5 V at RTC.\nUSB-C source must supply 5 V; no USB PD or data on J1."
		(exclude_from_sim no)
		(at 32.766 96.012 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "283a1aee-0506-5af2-b894-ff4c6f8fa69c")
	)
	(text "CONTROLLER  |  SINGLE SOLDERED 1x22 ROW"
